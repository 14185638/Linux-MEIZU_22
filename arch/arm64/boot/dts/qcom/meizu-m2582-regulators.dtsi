// SPDX-License-Identifier: BSD-3-Clause
/*
 * Meizu 22 (M2582) -- PMXR2230 regulators through the upstream RPMh driver.
 *
 * Moves the rails the PMXR2230 owns off qcom-tuna-boot-regulator and onto
 * qcom-rpmh-regulator, which already knows this PMIC family (PM7550, added by
 * postmarketOS, has the same 23-LDO layout). Layout follows upstream, see
 * qcom/eliza-mtp.dts: one sibling node per PMIC under &apps_rsc, each with its
 * own qcom,pmic-id. The driver builds each resource name from that id and the
 * rail index -- "ldo" + "b" + 8 = "ldob8" -- then resolves the address in the
 * firmware command DB, so no address is hard-coded.
 *
 * Voltage values are copied verbatim from what the private driver already
 * requested: those requests are known to boot, and this change is about who
 * provides the rails, not what they are set to.
 *
 * Every rail is regulator-always-on, matching what the private driver used and
 * for a reason that was measured the hard way. boot-on is NOT equivalent: it
 * only keeps the rail enabled at startup, and regulator_init_complete() still
 * switches off a rail whose use_count is zero. That happens around 31 s in, and
 * the log from the first attempt at this file shows exactly what it costs:
 *
 *     [   31.742933] ldob3: disabling
 *     [   31.744107] ldob5: disabling
 *     [   31.745271] ldob8: disabling
 *     [   31.746426] ldob19: disabling
 *
 * ldob3 and ldob5 belong to the USB PHYs, so the board did not hang -- it
 * merely lost USB, which looked identical to a hang because the console is on
 * USB. always-on is the honest description here: these rails power PHYs, UFS
 * and the panel, and there is no state of this board in which switching them
 * off is correct.
 *
 * No vdd-*-supply yet: the driver table names parent supplies and the core
 * tolerates a named supply the tree does not provide, but not a rail whose
 * parent cannot be resolved.
 */
&apps_rsc {
	regulators-0 {
		compatible = "qcom,pmxr2230-rpmh-regulators";
		qcom,pmic-id = "b";

		vreg_ldob2: ldo2  { regulator-name = "ldob2";  regulator-min-microvolt = <880000>;  regulator-max-microvolt = <925000>;  regulator-always-on; };
		vreg_ldob3: ldo3  { regulator-name = "ldob3";  regulator-min-microvolt = <880000>;  regulator-max-microvolt = <950000>;  regulator-always-on; };
		vreg_ldob4: ldo4  { regulator-name = "ldob4";  regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-always-on; };
		/*
		 * At the bootloader's value on purpose, so registration writes nothing
		 * (the core skips a write when the target is already satisfied) and the
		 * runtime path can be exercised on its own. See the test hook at the
		 * bottom of qcom-rpmh-regulator.c.
		 */
		vreg_ldob5: ldo5  { regulator-name = "ldob5";  regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-always-on; };
		vreg_ldob7: ldo7  { regulator-name = "ldob7";  regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-always-on; };
		vreg_ldob8: ldo8  { regulator-name = "ldob8";  regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-always-on; };
		vreg_ldob12: ldo12 { regulator-name = "ldob12"; regulator-min-microvolt = <2504000>; regulator-max-microvolt = <3300000>; regulator-always-on; };
		vreg_ldob17: ldo17 { regulator-name = "ldob17"; regulator-min-microvolt = <2700000>; regulator-max-microvolt = <3544000>; regulator-always-on; };
		vreg_ldob19: ldo19 { regulator-name = "ldob19"; regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3544000>; regulator-always-on; };
	};
};
