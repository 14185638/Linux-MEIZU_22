// SPDX-License-Identifier: BSD-3-Clause
/dts-v1/;
#include "tuna.dtsi"
#include "meizu-m2582-memory.dtsi"
#include "meizu-m2582-power.dtsi"
#include "tuna-display.dtsi"
#include "tuna-usb.dtsi"
/*
 * The PMK8550 sits on the SPMI bus declared in tuna.dtsi. This brings in the
 * PMIC node, its SDAM2 (whose restart-reason field the bootloader reads to pick
 * between Linux and fastboot) and the nvmem-reboot-mode node that writes it.
 *
 * It also adds the PMIC's PON, RTC, GPIO and PWM blocks. PON and PWM are
 * status = "disabled" upstream, and none of the four needs an RPMh regulator,
 * so this deliberately stays clear of the RPMh path that hangs this board.
 */
#include "pmk8550.dtsi"

/ {
	model = "Meizu 22 (M2582) — experimental Linux bring-up";
	compatible = "meizu,m2582", "qcom,tuna";
	chassis-type = "handset";
	/* Live socinfo: SM8735 1.1, foundry 1, QRD platform 1.0. */
	qcom,msm-id = <0x1028f 0x10001>;
	qcom,board-id = <0x1000b 0x01>;
	/* ro.boot.proj_version=2, ro.boot.hw_version=6. */
	meizu,board-id = <0x02 0x06>;
	/* Live SMEM PMIC model order, no invented unused slots/revisions. */
	qcom,pmic-id-size = <7>;
	qcom,pmic-id = <74 80 69 70 69 86 72>;
	aliases { serial0 = &uart7; };
	chosen {
		bootargs = "console=tty0 console=ttyGS0,115200n8 loglevel=8 ignore_loglevel clk_ignore_unused pd_ignore_unused cpuidle.off=1 initcall_debug rdinit=/init";
	};
};
/*
 * Merge a "normal" mode into the reboot-mode node that pmk8550.dtsi creates.
 *
 * Without it the kernel writes nothing on a plain reboot. The framework only
 * writes when the magic is non-zero --
 *
 *     magic = get_reboot_mode_magic(reboot, cmd);
 *     if (magic)
 *             reboot->write(reboot, magic);
 *
 * -- and a plain reboot passes cmd == NULL, which is treated as "normal", for
 * which pmk8550.dtsi defines no mode at all (only recovery and bootloader). So
 * the restart-reason field kept whatever the last entry into fastboot had left
 * there, and every warm reset went back to fastboot. Zero cannot be used here
 * either: zero is exactly the value the framework refuses to write.
 *
 * 0x7f is the way out, and it was measured rather than guessed. The PMK8550's
 * SDAM2 field at offset 0x48 is seven bits wide (bits = <1 7>), and writing a
 * value there really does steer the bootloader:
 *
 *     write 0x04 (0x02 << 1, "bootloader")  ->  6 s later, fastboot
 *     write 0xfe (0x7f << 1)                -> 18 s later, Linux
 *
 * ABL prints "Boot reason: 0x%x not handled, defaulting to Normal Boot", so an
 * unrecognised value is precisely what boots Linux. 0x7f is outside the small
 * set it knows, and unlike zero it is non-zero, so the framework will write it.
 *
 * mode-recovery (0x01) and mode-bootloader (0x02) come from pmk8550.dtsi and
 * are what `reboot recovery` and `reboot bootloader` use.
 */
/ {
	reboot-mode {
		mode-normal = <0x7f>;
	};
};

/* Ordinary USB cable diagnostics: keep the unconnected UART disabled. */
&uart7 { status = "disabled"; };
&ufsphy_mem {
	vdda-phy-supply = <&vreg_ldof1>;
	vdda-pll-supply = <&vreg_ldob4>;
	vdda-qref-supply = <&vreg_ldob2>;
	status = "okay";
};
&ufshc_mem {
	vcc-supply = <&vreg_ldob12>;
	vccq-supply = <&vreg_ldof3>;
	vcc-max-microamp = <1200000>;
	vccq-max-microamp = <1200000>;
	status = "okay";
};
